# PostgreSQL（接入持久化阶段启用）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dut_link"

# 三项 AI 能力共用兼容 Chat Completions 的服务端适配器：
# 1) 能力画像解释 2) 智能组队排序 3) 探索盲盒生成
# 禁止使用 NEXT_PUBLIC_ 前缀，密钥不得进入浏览器包
AI_API_KEY=""
AI_BASE_URL="https://your-provider.example/v1"
AI_MODEL="your-model-name"

# 登录会话签名；生产环境必须替换为至少 32 字节的随机值
SESSION_SECRET="change-me-in-production"
