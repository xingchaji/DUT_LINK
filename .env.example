# 默认使用零配置演示模式，clone 后无需安装数据库即可启动
DATA_BACKEND="memory"

# 需要持久化时改为 postgresql，并取消下一行注释；特殊字符密码需 URL 编码
# DATABASE_URL="postgresql://postgres:your-password@localhost:5432/dut_link"

# 三项 AI 能力共用兼容 Chat Completions 的服务端适配器：
# 1) 能力画像解释 2) 智能组队排序 3) 探索盲盒生成
# 禁止使用 NEXT_PUBLIC_ 前缀，密钥不得进入浏览器包
AI_API_KEY=""
AI_BASE_URL="https://your-provider.example/v1"
AI_MODEL="your-model-name"
# 用户在个人主页保存的 AI 密钥使用 AES-256-GCM 加密；生产环境必须设置独立随机值
AI_SETTINGS_ENCRYPTION_KEY="change-me-to-a-random-secret-with-at-least-32-bytes"

# 内存演示模式的登录会话签名；生产环境必须替换为至少 32 字节的随机值
SESSION_SECRET="change-me-to-another-random-secret-with-at-least-32-bytes"
