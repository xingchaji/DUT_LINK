generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  major       String?
  grade       String?
  bio         String?
  passwordHash String?
  profile     Profile?
  experiences Experience[]
  awards      Award[]
  achievements Achievement[]
  repositories GitHubRepository[]
  interests   UserInterest[]
  memberships TeamMember[]
  sessions    Session[]
  recruitmentPosts RecruitmentPost[]
  applications RecruitmentApplication[]
  articles    Article[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Profile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  summary             String
  skills              Json
  potentialDirections String[]
  embedding           Float[]
  version             Int      @default(1)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  type        String
  startedAt   DateTime?
  endedAt     DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Award {
  id          String   @id @default(cuid())
  userId      String
  title       String
  level       String?
  awardedAt   DateTime?
  evidenceUrl String?
  description String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  evidenceUrl String?
  metrics     Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GitHubRepository {
  id          String   @id @default(cuid())
  userId      String
  url         String
  name        String
  description String?
  languages   Json?
  stars       Int      @default(0)
  lastSyncedAt DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Interest {
  id    String         @id @default(cuid())
  name  String         @unique
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  weight     Float    @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String
  desiredSkills String[]
  members     TeamMember[]
  createdAt   DateTime     @default(now())
}

model TeamMember {
  teamId   String
  userId   String
  role     String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  organizer   String
  type        String
  description String
  sourceName  String
  sourceUrl   String
  sourceHash  String?
  status      String
  deadline    DateTime?
  tags        String[]
  bonusPolicy Json?
  verifiedAt  DateTime?
  recruitments RecruitmentPost[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecruitmentPost {
  id            String   @id @default(cuid())
  opportunityId String
  ownerId       String
  teamName      String
  description   String
  neededSkills  String[]
  capacity      Int
  contact       String?
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  owner         User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications  RecruitmentApplication[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RecruitmentApplication {
  id            String   @id @default(cuid())
  recruitmentId String
  applicantId   String
  message       String
  status        String   @default("pending")
  recruitment   RecruitmentPost @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  applicant     User @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([recruitmentId, applicantId])
}

model Article {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  summary     String
  content     String?
  bridge      String
  status      String   @default("pending")
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
